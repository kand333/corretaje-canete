# =============================================================================
# BACKEND (@portal/api) - environment variables template
# =============================================================================
# `npm run setup` copies this file to `.env.local` (not versioned) and generates
# AUTH_SECRET. Everything here is server-only: never use the NEXT_PUBLIC_ prefix.
# Tests (NODE_ENV=test) ignore .env.local and read `.env.test.local`.
# New integrations: add a section here and to tests/env-example.test.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database - PostgreSQL (required, SECRET outside local development)
# -----------------------------------------------------------------------------
# Default: the local Docker database of docker-compose.yml (`npm run db:up`).
# The role needs CREATEDB so `prisma migrate dev` can create its shadow database.
# Managed providers (Supabase, Neon, RDS...): see docs/recipes/.
DATABASE_URL=postgresql://postgres:postgres@localhost:5443/app

# -----------------------------------------------------------------------------
# 2. Authentication (required, SECRET)
# -----------------------------------------------------------------------------
# Signs the session tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# -----------------------------------------------------------------------------
# 3. Cloudinary - images (SECRET). Keys: https://console.cloudinary.com/settings/api-keys
# -----------------------------------------------------------------------------
# Recipe: docs/recipes/cloudinary.md. The API key must be able to create and delete assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# 4. Supabase - production PostgreSQL (SECRET). Recipe: docs/recipes/supabase-vercel.md
# -----------------------------------------------------------------------------
# Supabase is only the production database: development and tests stay on Docker.
# To run `npm run db:deploy`, temporarily replace DATABASE_URL (section 1) with the
# session pooler URL below, then switch back. Never run db:migrate or db:seed against it.
# Session pooler (port 5432), for db:deploy from this machine:
# DATABASE_URL=postgresql://prisma.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
# Transaction pooler (port 6543), for Vercel environment variables:
# DATABASE_URL=postgresql://prisma.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
